# Copy this file to .env for local development.
# In Docker Compose, these are set directly in docker-compose.yml.

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://trails:trails@localhost:5432/trails?schema=public"

# Base64/hex secret is not required: sessions use opaque random tokens (AD-6).
NODE_ENV="development"

# Whether the session cookie is marked `Secure` (only sent back to the
# browser over HTTPS). Leave "false" for local dev and for the default
# docker-compose deployment, which serves plain HTTP with no TLS. Set to
# "true" only once an operator fronts this deployment with their own
# TLS-terminating reverse proxy -- setting it to "true" over plain HTTP
# causes browsers to silently drop the cookie and login will appear to
# succeed while the session never actually persists.
COOKIE_SECURE="false"
