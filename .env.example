# Copy this file to .env for local development.
# In Docker Compose, these are set directly in docker-compose.yml.

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://trails:trails@localhost:5432/trails?schema=public"

# Base64/hex secret is not required: sessions use opaque random tokens (AD-6).
NODE_ENV="development"

# Whether the session cookie is marked `Secure` (only sent back to the
# browser over HTTPS). Leave "false" for local dev and for the default
# docker-compose deployment, which serves plain HTTP with no TLS. Set to
# "true" only once an operator fronts this deployment with their own
# TLS-terminating reverse proxy -- setting it to "true" over plain HTTP
# causes browsers to silently drop the cookie and login will appear to
# succeed while the session never actually persists.
COOKIE_SECURE="false"

# --- Web Push notifications (spec-push-notifications) -------------------
# Optional. Leave these unset and the notification opt-in simply never
# appears anywhere -- the app behaves exactly as it did before the feature
# existed. Set them to let readers approve notifications for new Blog Posts.
#
# Generate the pair ONCE with:
#   npx web-push generate-vapid-keys
#
# These must stay STABLE across deployments: every browser subscription is
# bound to the public key it was created with, so changing them silently
# invalidates every existing subscriber (everyone has to opt in again).
# The private key is a secret -- keep it out of version control.
#
# NOTE: notifications also require the site to be served over HTTPS (the
# Push API and Service Workers are secure-context only; localhost is the
# one exception). On a plain-HTTP deployment the Settings toggle explains
# this instead of offering a switch that could never work.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for the pushing party, used only by Push Services to reach an
# operator about a misbehaving sender. `mailto:` or an https URL.
VAPID_SUBJECT="mailto:you@example.com"
