<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-language support: declares Trails' supported per-app languages so
     API 33+'s system Settings > System > Languages > App languages screen
     lists them (AppCompatDelegate.setApplicationLocales itself works on
     every minSdk regardless of this file, see ui/settings). -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="sv"/>
    <locale android:name="en"/>
</locale-config>
