// Trails — foundation schema (User, Session, Trip, Section, TimelineEntry).
// AD-4's polymorphic Tags/Links/Photos tables landed in
// spec-tags-links-photos.md, alongside Attachments (spec-documents.md,
// FR-24/FR-25) -- see the Attachment/Tag/Link/Photo models below.
//
// AD-2's Section EXCLUDE USING gist constraint (btree_gist) is not
// representable in the Prisma schema language. It is added as raw SQL in
// prisma/migrations/20260817131140_init/migration.sql and is authoritative
// there — this file intentionally does not model it. Only
// `prisma migrate deploy` (never `migrate dev`/`db push`) is run against
// real databases (AD-13), so this permanent, documented drift never
// triggers a reset.
//
// That migration also documents one disclosed, verified deviation from
// AD-2's literal SQL text ('[)' instead of '[]' in the daterange bound) —
// needed so touching-endpoint Sections are allowed per FR-5, since '[]' is
// inclusive-inclusive and Postgres does not collapse it at a shared
// boundary date. Flagged for human confirmation, see migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  createdChecklists Checklist[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

enum TripVisibility {
  PUBLIC
  PRIVATE

  @@map("trip_visibility")
}

model Trip {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  destination String?
  // Stored as a plain calendar date; "today" for Status/auto-scroll is
  // always computed server-side against `timezone` (AD-8), never against
  // these dates in UTC or in the browser's local zone.
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  // Required IANA timezone identifier, e.g. "Asia/Bangkok" (AD-8).
  timezone    String
  description String?
  coverImage  String?        @map("cover_image")
  visibility  TripVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  sections       Section[]
  timelineEntries TimelineEntry[]
  ideas          Idea[]
  checklists     Checklist[]
  attachments    Attachment[]
  importantInfo  ImportantInfo[]
  photos         Photo[]

  @@map("trips")
}

model Section {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid

  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  // spec-sections-color-emoji: both nullable — a Section a User never
  // customizes keeps rendering via the existing auto-cycled fallback
  // (sectionColor/sectionColorSolid, lib/section-colors.ts), no behavior
  // change for existing rows or a create/edit that omits them. Stored as a
  // plain string (not an enum) but only ever set to a member of the
  // curated SECTION_COLOR_PALETTE/SECTION_EMOJI_OPTIONS constants
  // (lib/section-colors.ts) — enforced in lib/validation.ts, not a DB
  // constraint (same "curated set, not free-form input" enforcement point
  // used elsewhere in this codebase for a fixed list of allowed values).
  color     String?
  emoji     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // AD-2 ("no FK from anything else to Section") governs TimelineEntry
  // specifically -- its date-anchored rows compute Section membership from
  // timezone-localized dates, never a stored pointer, to avoid a stored
  // value drifting from the entry's own actual date. Idea rows carry no
  // date at all, so that computed-membership approach has nothing to
  // compute from; `ideas` below is a real, explicit, optional FK, the one
  // deliberate exception to AD-2's literal statement. onDelete: SetNull so
  // deleting a Section un-links its Ideas rather than deleting them.
  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ideas Idea[]

  @@index([tripId])
  @@map("sections")
}

// FR-16/FR-17, spec-ideas: an unconfirmed candidate, not shown on the
// Timeline. Scoped to spec-ideas.md's literal field list (title, category,
// priority, weather suitability + free-form tags, estimated expense) plus
// AD-11's Location fields (Idea is explicitly one of AD-11's Location-owning
// rows -- an Idea is "a candidate place or activity," per the PRD Glossary;
// omitting it from the initial pass was a spec gap, not a deliberate
// exclusion, unlike Tags/Links/Photos below). No Tags/Links/Photos
// (AD-4's polymorphic tables are still deferred, same exclusion already
// applied to TimelineEntry).
enum IdeaPriority {
  MUST_DO
  WOULD_LIKE
  MAYBE

  @@map("idea_priority")
}

enum WeatherSuitability {
  INDOOR
  OUTDOOR
  EITHER

  @@map("weather_suitability")
}

model Idea {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid
  // Optional -- see Section model's own comment for why this is the one
  // deliberate exception to AD-2's "no FK from anything else to Section."
  // Deliberately not required to belong to the same tripId at the DB
  // level (no composite FK) -- the Route Handler checks that itself so the
  // error is a clean 400 rather than a Postgres constraint violation.
  sectionId String? @map("section_id") @db.Uuid

  title              String
  category           String?
  priority           IdeaPriority
  weatherSuitability WeatherSuitability @map("weather_suitability")
  // Free-form tags (e.g. "Rainy day"), distinct from AD-4's still-deferred
  // polymorphic Tag table -- a plain array column owned entirely by Idea.
  weatherTags        String[]           @default([]) @map("weather_tags")

  // AD-11: Location is always embedded plain columns, never a shared
  // entity -- same shape as TimelineEntry's Location fields (lib/entry-
  // types/shared-fields.schema.ts's locationFields), carried over verbatim
  // on conversion (FR-17).
  locationName    String?  @map("location_name")
  locationAddress String?  @map("location_address")
  locationLat     Decimal? @map("location_lat") @db.Decimal(9, 6)
  locationLng     Decimal? @map("location_lng") @db.Decimal(9, 6)
  locationMapLink String?  @map("location_map_link")

  // Estimated expense (FR-16): amount+currency travel together or not at
  // all, same "both or neither" rule as TimelineEntry's Expense (FR-22),
  // enforced in lib/validation.ts, not a DB constraint. Converting an Idea
  // (FR-17) maps this pair onto the new TimelineEntry's own Expense fields.
  estimatedExpenseAmount   Decimal? @map("estimated_expense_amount") @db.Decimal(12, 2)
  estimatedExpenseCurrency String?  @map("estimated_expense_currency")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Converting an Idea deletes it (FR-17) -- no stored link survives to a
  // TimelineEntry it became; Cascade here only covers Trip deletion.
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([sectionId])
  @@map("ideas")
}

// AD-1: TimelineEntry is one table discriminated by `entry_type`
// (spec-timeline-entries implements Stay/Transport/Activity/Note now;
// BlogPost is a valid discriminator value per AD-1's literal rule so a
// later Blog spec is an additive change, not a migration -- but no
// create/edit path in this spec ever writes entryType=BLOG_POST).
enum EntryType {
  STAY
  TRANSPORT
  ACTIVITY
  NOTE
  BLOG_POST

  @@map("entry_type")
}

// Entry Subtype (FR-11/FR-12/FR-13): one enum spanning every type's
// allowed values, each prefixed distinctly per type (STAY_OTHER vs
// TRANSPORT_OTHER vs ACTIVITY_OTHER) so the *database* column itself can
// never hold a value from the wrong type's subtype set -- defense in depth
// on top of the per-entry_type Zod schema (lib/entry-types/*.schema.ts)
// that is the actual enforcement point per AD-1/FR-15.
enum EntrySubtype {
  // Stay (FR-11)
  HOTEL
  HOSTEL
  RESORT
  APARTMENT
  VILLA
  GUESTHOUSE
  STAY_OTHER
  // Transport (FR-12)
  FLIGHT
  TRAIN
  FERRY
  BUS
  CAR
  TAXI
  TRANSFER
  TRANSPORT_OTHER
  // Activity (FR-13)
  TOUR
  RESTAURANT
  ATTRACTION
  EVENT
  BEACH
  HIKE
  MUSEUM
  SHOPPING
  NIGHTLIFE
  ACTIVITY_OTHER

  @@map("entry_subtype")
}

model TimelineEntry {
  id        String    @id @default(uuid()) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  entryType EntryType @map("entry_type")
  subtype   EntrySubtype?

  title       String
  description String?

  // AD-1: one shared temporal pair for every type. Per a later correction
  // to AD-8: these are the traveler's own literal wall-clock digits, not
  // real UTC instants -- stored as UTC purely as a column-type convenience
  // (dateTimeField, lib/validation.ts, never applies a real timezone
  // conversion unless startTimezone/endTimezone below says otherwise).
  // `endAt` is NULL for a Note (date-only) and may be NULL for a
  // point-in-time Activity; Stay/Transport always populate it (checked in
  // the per-type Zod schema, not a DB constraint, so the error stays a
  // clean 400 per AD-1's "validated ... against exactly one Zod schema per
  // entry_type").
  startAt DateTime  @map("start_at") @db.Timestamptz(6)
  endAt   DateTime? @map("end_at") @db.Timestamptz(6)

  // spec-timeline-ux-and-timezone (correction): NULL (the default, and the
  // only option for every type but Transport) means startAt/endAt are
  // literal wall-clock digits with no real timezone attached at all -- see
  // startAt/endAt's own comment. A traveler-declared IANA zone here means
  // the stored instant is instead a real, correctly-computed UTC instant
  // that must be converted through *this* zone to recover the intended
  // clock time -- for a Transport Entry whose departure and arrival are in
  // different real timezones (a flight), so the Timeline places each leg
  // correctly and "arrival after departure" validates against real time.
  startTimezone String? @map("start_timezone")
  endTimezone   String? @map("end_timezone")

  // AD-11: Location is embedded plain columns, never a shared entity --
  // one Location per row, used by Stay/Transport/Activity, left NULL for
  // Note (FR-14: "no Location ... fields ... shown for this type").
  locationName    String?  @map("location_name")
  locationAddress String?  @map("location_address")
  locationLat     Decimal? @map("location_lat") @db.Decimal(9, 6)
  locationLng     Decimal? @map("location_lng") @db.Decimal(9, 6)
  locationMapLink String?  @map("location_map_link")

  // Shared per FR-15, but withheld for Note (FR-14).
  bookingReference String? @map("booking_reference")

  // spec-entry-fields-datepickers: a venue/booking's own website and how it
  // was booked (e.g. "Booking.com") -- new, additive fields alongside
  // bookingReference above, same shape/visibility (Stay/Transport/Activity
  // only, withheld for Note).
  website   String? @map("website")
  bookedVia String? @map("booked_via")

  // Expense (FR-22 is out of scope for aggregation, but recording one on an
  // Entry here is explicitly in scope per this spec's "Ask First" note).
  expenseAmount        Decimal? @map("expense_amount") @db.Decimal(12, 2)
  expenseCurrency      String?  @map("expense_currency")
  expensePaymentStatus String?  @map("expense_payment_status")
  expensePaymentNote   String?  @map("expense_payment_note")

  // Contact Information (FR-15) -- shared across every type, Note included.
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  // Distinct from Post-Trip Notes (FR-15): planning-time notes vs. notes
  // added and retained after the Trip is Completed.
  notes         String?
  postTripNotes String? @map("post_trip_notes")

  // AD-1: genuinely type-only fields (Stay's room info; Transport's
  // terminal/gate/platform/service number/seat/baggage), validated per
  // entry_type by exactly one Zod schema each (lib/entry-types/*.schema.ts).
  // Never defined or inferred independently anywhere else.
  typeDetails Json @default("{}") @map("type_details")

  // AD-1: real shared column, not JSONB. NULL = Draft, set = Published
  // (FR-19). Unused by this spec's create/edit paths (always NULL here) --
  // reserved for the Blog spec, which is why it must already exist as a
  // real column rather than a later migration.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  // spec-guest-access (FR-28/AD-10): unlike ImportantInfo.isPrivate (still
  // inert -- no Guest surface exists for Important Info), this flag is read
  // by lib/viewer.ts's `filterForViewer` on every Guest-eligible read path
  // (Timeline, Entry detail, Blog list/detail) and has a real, immediate
  // effect -- a Guest never sees an item with `isPrivate=true`, even on an
  // otherwise-Public Trip. Covers every entry_type including BlogPost (a
  // Private Published post is excluded from the Guest-visible Blog list and
  // 404s directly, same as a Draft).
  isPrivate Boolean @default(false) @map("is_private")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // No stored Section reference (AD-2) -- Section membership is always
  // derived from `startAt` at render time, never a foreign key here.
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // AD-1: "Index (trip_id, start_at) on timeline_entries; this is the
  // index the Timeline's ~1s performance NFR depends on."
  @@index([tripId, startAt])
  @@map("timeline_entries")
}

// FR-21, spec-checklists: a Trip may have multiple Checklists (packing
// lists, pre-departure tasks, ...). Deliberately no Section association of
// any kind -- Checklists have no date of their own to derive Section
// membership from, and no manual tag either (spec's frozen Intent).
model Checklist {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid

  title       String
  description String?

  // User-clarified: "Guests can't see checklists. they are only for signed
  // in users. With private checklist, its only visible to the user who
  // created it. If not marked as private, the checklist can be seen and
  // edited by all signed in users." Guest exclusion was already true (no
  // Guest-eligible surface for Checklists at all, see proxy.ts's
  // GUEST_ELIGIBLE_PATH). isPrivate now has real enforcement, unlike
  // ImportantInfo.isPrivate -- see createdByUserId below, and
  // lib/checklist-access.ts for the shared predicate every Checklist/
  // ChecklistItem route applies.
  isPrivate Boolean @default(false) @map("is_private")

  // Who created this Checklist -- the only "ownership" concept this app
  // has for any resource (AD-7 is explicit that Trips themselves have
  // none). Required so a private Checklist has someone to be private TO;
  // backfilled for pre-existing rows in this feature's own migration.
  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // No Section field anywhere on Checklist or ChecklistItem (spec's
  // "Never" boundary) -- Trip is the only relation.
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdByUserId], references: [id])
  items     ChecklistItem[]

  @@index([tripId])
  @@index([createdByUserId])
  @@map("checklists")
}

// A Checklist Item's `checked` toggle is a single-request, no-confirmation
// action (spec's "Always" boundary, PRD FR-21's "single-tap action").
model ChecklistItem {
  id          String  @id @default(uuid()) @db.Uuid
  checklistId String  @map("checklist_id") @db.Uuid

  text    String
  checked Boolean @default(false)
  note    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Cascade from Checklist to its Items (spec's Code Map) -- deleting a
  // Checklist deletes its Items, never orphaning rows.
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

// FR-26, spec-important-info: trip-wide reference content that isn't tied to
// any one Entry -- insurance, passport copies, visa info, emergency
// contacts, embassy details, SIM/eSIM, addresses, emergency instructions.
// Same "Trip has many, no Section association" shape as Checklist (spec's
// frozen Intent) -- no date of its own to derive Section membership from.
// Location/Contact fields are AD-11/FR-15's shared shape, reused verbatim
// from lib/entry-types/shared-fields.schema.ts's locationFields/contactFields
// (same columns as TimelineEntry/Idea).
model ImportantInfo {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid

  title   String
  content String?

  locationName    String?  @map("location_name")
  locationAddress String?  @map("location_address")
  locationLat     Decimal? @map("location_lat") @db.Decimal(9, 6)
  locationLng     Decimal? @map("location_lng") @db.Decimal(9, 6)
  locationMapLink String?  @map("location_map_link")

  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  // FR-26's `isPrivate` toggle is stored and PATCH-toggleable but has no
  // read-time enforcement effect in this pass -- AD-10 is explicit that
  // Important Info sits entirely behind requireAuth already (no Guest
  // surface exists yet for this flag to exclude an item from). See
  // spec-important-info.md's disclosed "isPrivate" note.
  isPrivate Boolean @default(false) @map("is_private")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // No Section field anywhere (spec's "Never" boundary) -- Trip is the only
  // relation, same as Checklist.
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("important_info")
}

// spec-tags-links-photos: originally `AttachmentOwnerType` (TIMELINE_ENTRY |
// IMPORTANT_INFO only, Idea deliberately excluded from Attachments per
// FR-16). Tags/Links/Photos need all three owner types
// (TIMELINE_ENTRY | IDEA | IMPORTANT_INFO per AD-4's literal Rule), and
// defining three more near-identical enums would recreate the exact "two
// incompatible owner_type conventions for the same conceptual entity" AD-4's
// own "Prevents" clause warns against -- so this migration renames the type
// itself (`ALTER TYPE attachment_owner_type RENAME TO
// polymorphic_owner_type`, safe/additive/no existing value touched) and adds
// `IDEA` as a new member, then reuses this one enum as the `owner_type`
// column type on Attachment, Tag, Link, and Photo alike. Attachment's own
// allowed subset at the application layer is unchanged (still
// TIMELINE_ENTRY | IMPORTANT_INFO only, enforced in
// app/api/v1/attachments/route.ts) -- the shared DB enum doesn't weaken
// that, it only removes the duplicate-type-definition risk. See
// prisma/migrations/20260818000000_tags_links_photos/migration.sql.
enum PolymorphicOwnerType {
  TIMELINE_ENTRY
  IMPORTANT_INFO
  IDEA

  @@map("polymorphic_owner_type")
}

model Attachment {
  id     String @id @default(uuid()) @db.Uuid
  // AD-5: "the upload handler resolves trip_id via the owner lookup before
  // writing" -- a denormalized column, not derived at read time, so the
  // Documents page (FR-25) is a single flat query keyed on this column
  // rather than a per-owner-type union.
  tripId String @map("trip_id") @db.Uuid

  // Polymorphic owner reference (AD-4) -- ownerId is NOT a declarable Prisma
  // relation since the table it points into varies with ownerType. Deleting
  // the owning TimelineEntry deletes these rows via an explicit
  // delete-attachments-first step in that route's DELETE handler
  // (app/api/v1/timeline-entries/[entryId]/route.ts), documented inline
  // there since Prisma can't express this FK's cascade declaratively.
  // Attachment's own allowed subset (TIMELINE_ENTRY | IMPORTANT_INFO) is
  // still enforced at the application layer only -- IDEA is a valid enum
  // value but every Attachment Route Handler still 400s it (spec-tags-
  // links-photos's "Never" boundary: "No change to Attachment's own
  // allowed-owner-type subset").
  ownerType PolymorphicOwnerType @map("owner_type")
  ownerId   String               @db.Uuid @map("owner_id")

  // AD-5: only path + metadata is ever stored here -- file bytes always live
  // on the `uploads` volume at exactly this path, never in Postgres.
  filePath         String @map("file_path")
  mimeType         String @map("mime_type")
  sizeBytes        Int    @map("size_bytes")
  originalFilename String @map("original_filename")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // tripId IS a real, declarable FK (unlike ownerId above) -- this gives a
  // genuine DB-level cascade so a direct Trip delete (which cascades its
  // TimelineEntries at the DB layer, bypassing the TimelineEntry DELETE
  // route's own explicit Attachment cleanup step) can never leave orphaned
  // Attachment rows behind, even though the files themselves stay on disk
  // (spec's Boundaries: "no v1 requirement for a Trip-deletion disk-purge
  // script; noted as deferred, not silently ignored").
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([ownerType, ownerId])
  @@map("attachments")
}

// FR-15/FR-16/FR-26, spec-tags-links-photos, AD-4: one row per free-text tag
// label (not a JSON array column) -- distinct from Idea.weatherTags, which
// stays its own simpler, unrelated mechanism (see Idea's own schema comment
// above). Same non-FK polymorphic (ownerType, ownerId) pattern as
// Attachment.ownerId -- cascade-cleanup lives in each owning entity's own
// DELETE route (app/api/v1/timeline-entries, ideas, important-info), not a
// DB constraint. No Guest-facing surface (spec's "Never" boundary) and no
// tag-based filtering/search UI in this pass (spec's "Ask First" boundary,
// not requested by any FR).
model Tag {
  id String @id @default(uuid()) @db.Uuid

  ownerType PolymorphicOwnerType @map("owner_type")
  ownerId   String               @db.Uuid @map("owner_id")

  text String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerType, ownerId])
  @@map("tags")
}

// FR-15/FR-16/FR-26, spec-tags-links-photos, AD-4: a labeled URL attached to
// a TimelineEntry/Idea/ImportantInfo row. Same polymorphic (ownerType,
// ownerId) pattern as Tag above -- no Guest-facing surface (spec's "Never"
// boundary: only Photos are Guest-visible per FR-28's literal text).
model Link {
  id String @id @default(uuid()) @db.Uuid

  ownerType PolymorphicOwnerType @map("owner_type")
  ownerId   String               @db.Uuid @map("owner_id")

  url   String
  label String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerType, ownerId])
  @@map("links")
}

// FR-3/FR-15/FR-16/FR-26/FR-28, spec-tags-links-photos, AD-4: a photo
// attached to a TimelineEntry/Idea/ImportantInfo row. Same
// upload-metadata-only shape as Attachment (AD-5: only path + metadata ever
// stored here, file bytes live on the uploads volume) but image-only
// (image/jpeg | image/png, enforced by lib/photos.ts -- no PDF, these are
// Photos not generic Attachments) and, unlike Attachment/Tag/Link, part of
// the Guest-visible surface (FR-3/FR-28) via `isPrivate` -- the only place
// that flag is evaluated for read access is `filterForViewer`
// (lib/viewer.ts, spec-guest-access), reused here, not reinvented.
//
// `isPrimary` implements Cover Photo (FR-15's "thumbnail in list views"): at
// most one `isPrimary = true` row per (owner_type, owner_id), enforced by a
// partial unique index -- not representable in Prisma's schema language
// (same documented limitation as AD-2's EXCLUDE constraint on Section
// above), so it's added as raw SQL in this feature's own migration
// (prisma/migrations/20260818000000_tags_links_photos/migration.sql) and is
// authoritative there. This file intentionally does not model it.
model Photo {
  id String @id @default(uuid()) @db.Uuid

  // AD-5: "the upload handler resolves trip_id via the owner lookup before
  // writing" -- denormalized, same as Attachment.tripId, so a genuine DB-level
  // FK/cascade exists even though ownerId itself can't be a declared relation.
  tripId String @map("trip_id") @db.Uuid

  ownerType PolymorphicOwnerType @map("owner_type")
  ownerId   String               @db.Uuid @map("owner_id")

  filePath         String @map("file_path")
  mimeType         String @map("mime_type")
  sizeBytes        Int    @map("size_bytes")
  originalFilename String @map("original_filename")

  // Cover Photo (FR-15) -- at most one true per owner (partial unique index,
  // raw SQL migration, see model comment above).
  isPrimary Boolean @default(false) @map("is_primary")
  // FR-3/FR-28: Guest-visibility flag, evaluated only by
  // lib/viewer.ts's `filterForViewer` -- same semantics/shape as
  // TimelineEntry.isPrivate (spec-guest-access).
  isPrivate Boolean @default(false) @map("is_private")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([ownerType, ownerId])
  @@map("photos")
}
